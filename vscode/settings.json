{
  "$comment": "unique settings(async)",
  "settingsSync.ignoredSettings": [
    "$comment:which terminal to use",
    "terminal.external.osxExec",
    "$comment:font in terminal",
    "terminal.integrated.fontFamily",
    "$comment:[MAC]path to neovim configuration file(init.vim)",
    "vscode-neovim.neovimInitVimPaths.darwin",
    "vscode-neovim.neovimInitVimPaths.linux",
    "$comment:[MAC]path to neovim(e.g.: /opt/homevrew/bin/nvim)",
    "vscode-neovim.neovimExecutablePaths.darwin",
    "terminal.integrated.profiles.windows",
    "vscode-neovim.useWSL",
    "vscode-neovim.neovimExcecutablePaths.darwin",
    "$comment:[WSL]path to neovim(e.g.: /usr/bin/nvim)",
    "vscode-neovim.neovimExcecutablePaths.linux",
    "vscode_custom_css.imports"
  ],
  "vscode-neovim.useWSL": true,
  "vscode-neovim.neovimExcecutablePaths.linux": "/snap/bin/nvim",
  "vscode-neovim.neovimInitVimPaths.linux": "/home/maedat/.config/nvim/vscode.vim",
  "vscode_custom_css.imports": "/mnt/c/Users/Admin/AppData/Roaming/Code/User",
  "$comment": "sync settings",
  "vscode-neovim.mouseSelectionStartVisualMode": true,
  "vscode-neovim.useCtrlKeysForInsertMode": false,
  "vscode-neovim.useCtrlKeysForNormalMode": true,
  "$comment": "change to path at your .config/vscode/style.css path.",
  "$comment": "e.g.(MAC or Linux): file:///Users/maedatakurou/work/development/dotfiles/vscode/style.css",
  "$comment": "e.g.(Windows): file:///C:/Users/MyUserName/Documents/custom.css",
  "workbench.editor.showTabs": "multiple",
  "workbench.colorTheme": "Default Dark+",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.iconTheme": "vscode-icons",
  "workbench.list.fastScrollSensitivity": 1,
  "workbench.layoutControl.enabled": false,
  "workbench.editor.enablePreview": false,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.cursorBlinking": "solid",
  "editor.fastScrollSensitivity": 1,
  "editor.smoothScrolling": true,
  "editor.mouseWheelScrollSensitivity": 1,
  "editor.fontSize": 15,
  "editor.tabSize": 2,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.wordWrap": "off",
  "prettier.singleQuote": true,
  "prettier.semi": false,
  "terminal.external.osxExec": "iTerm.app",
  "terminal.integrated.fontFamily": "DroidSansMono Nerd Font",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash"
    },
    "Ubuntu (WSL)": {
      "path": "C:\\WINDOWS\\System32\\wsl.exe",
      "args": ["-d", "Ubuntu"]
    }
  },

  "macros": {
    "selectAndToggleSidebar": [
      "list.closeFind",
      "list.select",
      "workbench.action.toggleSidebarVisibility"
    ],
    "closeAndExpandFolder": ["list.closeFind", "list.expand"],
    "splitAndToggleSidebar": [
      "explorer.openToSide",
      "workbench.action.toggleSidebarVisibility"
    ],
    "filterAndFocusDown": [
      "list.toggleFilterOnType",
      "list.expandSelectionDown"
    ]
  },
  "git.confirmSync": false,
  "git.autofetch": true,
  "vsicons.dontShowNewVersionMessage": true,
  "vsicons.associations.folders": [],
  "update.mode": "none",
  "update.enableWindowsBackgroundUpdates": false,
  "extensions.autoUpdate": false,
  "liveServer.settings.donotShowInfoMsg": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  "dart.showInspectorNotificationsForWidgetErrors": false,
  "java.saveActions.organizeImports": true,
  "explorer.confirmDragAndDrop": false,
  "importSorter.importStringConfiguration.tabSize": 2,
  "search.exclude": {
    "**/node_modules": false
  },
  "files.trimTrailingWhitespace": true,
  "cSpell.userWords": [
    "appium",
    "dismissable",
