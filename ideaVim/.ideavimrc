" Solarized Theme
" https://qiita.com/HeRo/items/363b2aa18e7f225a8069#intellij-idea-%E3%81%AE%E8%A8%AD%E5%AE%9A

" 1st, Enable ide shortcut Ctrl + A(Select all)/C(Copy)
" IdeVim -> Settings
" Ctrl + A/C: undefined -> IDE

set ignorecase
set smartcase
set incsearch
set hlsearch
set showcmd
set clipboard+=unnamed
set virtualedit=onemore
set showmatch
set shiftwidth=2
set softtabstop=2
set multiple-cursors
set NERDTree

" Action list
" https://gist.github.com/zchee/9c78f91cc5ad771c1f5d

nnoremap gcc :action CommentByLineComment<CR><Esc>
vnoremap gc :action CommentByLineComment<CR><Esc>

nmap <c-n> <Action>(NextTab)
nmap <c-p> <Action>(PreviousTab)

nnoremap <c-o> :NERDTreeToggle<CR>


let mapleader = ' '
nmap <leader>h :action ShowHoverInfo<CR><Esc>
" nmap <leader>d :action GotoImplementation<CR>
nmap <leader>d :action GotoDeclaration<CR>
nmap <leader>b :action Back<CR>


" Default config
" ----------------------------
" Highlight copied text
Plug 'machakann/vim-highlightedyank'
" Commentary plugin
Plug 'tpope/vim-commentary'

" ----------------------------
