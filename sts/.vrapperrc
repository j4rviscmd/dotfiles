" 設定 -> 一般 -> キーよりデフォルト割当キーをアンバインドする"
" アドオンインストール時に java extensiton pack も入れること"
" -> 入れると visual modeの gc でコメントアウトされる "

set encoding=utf-8
scriptencoding utf-8

set nobackup
set noswapfile
set autoread
set virtualedit=onemore
set cursorline
set nowrap
set ignorecase
set smartcase
set hlsearch
set incsearch

set tapstop=4
set shiftwidth=4
set expandtab

set imd

set clipboard=unnamed


eclipseaction ShowInformation org.eclipse.ui.edit.text.showInformation
" nnoremap <Space>h :ShowInformation
nnoremap <Space>h :ShowInformation


" eclipseuiaction eclipsegotoRef org.eclipse.jdt.ui.edit.text.java.open.implementation
" nnoremap <Space>d :eclipsegotoRef<cr>
nnoremap <Space>d <C-]>

nnoremap <C-n> :tabnext<cr>
nnoremap <C-p> :tabprevious<cr>

eclipseuiaction HistoryBack org.eclipse.ui.navigate.backwardHistory
nnoremap <Space>b :HistoryBack<cr>

eclipseuiaction CommentOut org.eclipse.jdt.ui.edit.text.java.toggle.comment
nnoremap gcc :CommentOut<cr>

eclipseuiaction ContentAssist org.eclipse.ui.edit.text.contentAssist.proposals
inoremap <C-.> :ContentAssist<cr>
