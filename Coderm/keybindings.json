                "workbench.action.lockEditorGroup",
                "workbench.action.navigateRight",
                "workbench.action.createTerminalEditor",
                "workbench.action.lockEditorGroup",
                "workbench.action.newGroupBelow",
                "workbench.action.createTerminalEditor",
                "workbench.action.lockEditorGroup",
                "workbench.action.navigateLeft",
                "workbench.action.navigateLeft",
                "workbench.action.unlockEditorGroup",
