# ============================================================
# macOS固有設定
# ============================================================

# ============================================================
# Homebrew設定（Apple Silicon）
# Why: login shellでは/etc/zprofileのpath_helperがPATHを再構成し
#      /usr/local/bin(旧Intel Homebrewのbrew symlinkが現存)が先頭に来るため、
#      ここでevalして/opt/homebrew/binを先頭へ置く
#      (brew --prefixが/usr/localを返しantidote等が壊れるのを防ぐ)。削除注意
# ============================================================
eval "$(/opt/homebrew/bin/brew shellenv)"

# ============================================================
# antidote プラグインマネージャー
# ============================================================
source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh

# ============================================================
# libgit2設定
# ============================================================
export DYLD_LIBRARY_PATH="/opt/homebrew/opt/libgit2/lib:$DYLD_LIBRARY_PATH"

# ============================================================
# Android/Java設定 (Appium)
# ============================================================
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$ANDROID_HOME/platform-tools:$PATH"
export JAVA_HOME="/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home"
export PATH="$JAVA_HOME/bin:$PATH"

# ============================================================
# Google Cloud SDK
# ============================================================
if [ -f "$HOME/Downloads/google-cloud-sdk/path.zsh.inc" ]; then
  source "$HOME/Downloads/google-cloud-sdk/path.zsh.inc"
fi
