[
  {
    "$comment_": "close the filter widget if the focus after filtering on the tree operation is a folder",
    "command": "runCommands",
    "key": "Enter",
    "when": "listFocus && treeFindOpen && explorerResourceIsFolder",
    "args": {
      "commands": ["list.closeFind", "list.expand"]
    }
  },
  {
    "$comment_": "filter execution & j, k key activation by pressing enter in search by tree operation",
    "command": "runCommands",
    "key": "Enter",
    "when": "inputFocus && explorerViewletFocus",
    "args": {
      "commands": ["list.toggleFilterOnType", "list.expandSelectionDown"]
    }
  },
  {
    "$comment_": "split & close tree by pressing file in tree operation",
    "command": "runCommands",
    "key": "v",
    "when": "explorerViewletFocus && explorerViewletVisible && !explorerResourceIsFolder && !inputFocus",
    "args": {
      "commands": [
        "explorer.openToSide",
        "workbench.action.toggleSidebarVisibility"
      ]
    }
  },
  {
    "$comment_": "if a file in a file tree operation, open and close the tree",
    "key": "Enter",
    "command": "runCommands",
    "when": "explorerViewletFocus && explorerViewletVisible && !explorerResourceIsFolder && !inputFocus",
    "args": {
      "commands": [
        "list.closeFind",
        "list.select",
        "workbench.action.toggleSidebarVisibility"
      ]
    }
  },
  {
    "$comment": "When nvim is normal or visual mode comment out bind",
    "key": "g c c",
    "command": "editor.action.commentLine",
    "when": "neovim.mode == normal && editorTextFocus"
  },
  {
    "command": "vscode-neovim.send",
    "key": "g g",
    "when": "editorTextFocus && neovim.init && neovim.mode != insert || neovim.recording",
    "args": "gg"
  },
  {
    "$comment": "When nvim is normal or visual mode comment out bind",
    "key": "g c",
    "command": "runCommands",
    "when": "neovim.mode == visual && editorTextFocus",
    "args": {
      "commands": ["editor.action.commentLine", "vscode-neovim.escape"]
    }
  },
  {
    "$comment_": "show source control",
    "key": "ctrl+s",
    "command": "workbench.view.scm",
    "when": "!view.workbench.scm.visible"
  },
  {
    "$comment_": "not show source control",
    "key": "ctrl+s",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "view.workbench.scm.visible"
  },
  {
    "$comment_": "enable undo delete recent file key & useCtrlKeysForNormalMode: true and reboot"
  },
  {
    "key": "ctrl+.",
    "command": "editor.action.quickFix",
    "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly"
  },
  {
    "key": "space d",
    "command": "editor.action.goToDeclaration",
    "when": "neovim.mode == normal && editorTextFocus"
  },
  {
    "key": "space b",
    "command": "workbench.action.navigateBack",
    "when": "neovim.mode == normal && editorTextFocus"
  },
  {
    "key": "ctrl+[",
    "command": "vscode-neovim.escape",
    "when": "neovim.mode == insert && editorTextFocus"
  },
  {
    "$comment_": "expand if folder in file tree operation",
    "key": "Enter",
    "command": "list.toggleExpand",
    "when": "explorerViewletFocus && explorerViewletVisible && explorerResourceIsFolder && !inputFocus && !treeFindOpen"
  },
  {
    "key": "m r",
    "command": "renameFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "m c",
    "command": "filesExplorer.copy",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "m p",
    "command": "filesExplorer.paste",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "m a",
    "command": "explorer.newFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "m d",
    "command": "deleteFile",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "m f",
    "command": "explorer.newFolder",
    "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
  },
  {
    "key": "ctrl+n",
    "command": "workbench.action.nextEditor",
    "when": "neovim.mode == normal"
  },
  {
    "key": "ctrl+p",
    "command": "workbench.action.previousEditor",
    "when": "neovim.mode == normal"
  },
  {
    "key": "ctrl+u",
    "command": "-vscode-neovim.ctrl-u",
    "when": "editorTextFocus && neovim.ctrlKeysNormal && neovim.init && neovim.mode != 'insert'"
  },
  {
    "key": "ctrl+d",
    "command": "-vscode-neovim.ctrl-d",
    "when": "editorTextFocus && neovim.ctrlKeysNormal && neovim.init && neovim.mode != 'insert'"
  },
  {
    "command": "vscode-neovim.send",
    "key": "ctrl+d",
    "when": "editorTextFocus && neovim.init && neovim.mode != insert || neovim.recording",
    "args": "<C-D>"
  },
  {
    "command": "vscode-neovim.send",
    "key": "ctrl+u",
    "when": "editorTextFocus && neovim.init && neovim.mode != insert || neovim.recording",
    "args": "<C-U>"
  },
  {
    "key": "space h",
    "command": "editor.action.showHover",
    "when": "vim.mode == 'Normal' && editorTextFocus ||  neovim.mode == normal && editorTextFocus"
  },
  {
    "key": "ctrl+n",
    "command": "selectNextCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "cmd+down",
    "command": "-selectNextCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "ctrl+p",
    "command": "selectPrevCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "cmd+up",
    "command": "-selectPrevCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "ctrl+n",
    "command": "-selectNextCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "ctrl+r",
    "command": "-workbench.action.openRecent"
  },
  {
    "key": "f",
    "command": "-notebook.find",
    "when": "notebookEditorFocused && !inputFocus"
  },
  {
    "command": "runCommands",
    "key": "ctrl+o",
    "when": "neovim.mode != insert && !explorerViewletVisible",
    "args": {
      "commands": [
        "workbench.action.toggleSidebarVisibility",
        "workbench.view.explorer"
      ]
    }
  },
  {
    "command": "runCommands",
    "key": "ctrl+o",
    "when": "neovim.mode != insert && explorerViewletVisible",
    "args": {
      "commands": ["workbench.action.toggleSidebarVisibility"]
    }
  }
]
