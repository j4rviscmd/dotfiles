# ============================================================
# 秘匿環境変数(SSOT)。~/.config symlink経由でzsh/bashが、
# powershell/user_profile.ps1がrepo直下参照で読み込む。
# Git管理外(.gitignore済み)。このsampleをrepo直下に.envとしてコピーし値を記述。
# ============================================================

# --- GitHub ---
# export GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxx
# Why: gh CLIはGITHUB_TOKENも公式に認証用として読むため、旧GH_TOKEN行は廃止してこの1本に統一
# Note: GITHUB_TOKENはopencode側からも{env:GITHUB_TOKEN}で参照される(opencode/opencode.json)
# export GITHUB_TOKEN=ghp_xxx        # gh CLI等(ghはGITHUB_TOKEN公式対応)
# export GH_PROJECT_TOKEN=ghp_xxx    # add-to-project workflow用
# export GH_USAGE_STATUSBAR_PAT=ghp_xxx
# export VSCE_PAT=xxx                # VS Code Marketplace公開

# --- npm ---
# export NPM_TOKEN_ALL=npm_xxx
# export NPM_TOKEN_opencode_discord_notify=npm_xxx
# export NPM_TOKEN_opencode_agent_modes=npm_xxx

# --- Discord Webhook ---
# export DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# export DISCORD_WEBHOOK_COMPLETE_MENTION=@everyone
# export DISCORD_WEBHOOK_PERMISSION_MENTION=@everyone
# export DISCORD_WEBHOOK_FALLBACK_URL=https://discord.com/api/webhooks/...

# --- AI / LLM ---
# export ANTHROPIC_AUTH_TOKEN=sk-ant-xxx
# export ZAI_API_KEY=xxx
# export ZAI_WEB_READER_TOKEN=xxx
# export GLM_TOKEN=xxx               # tmux statusline GLM残量表示
# Note: ANTHROPIC_BASE_URL はwin専用(proxy指定)。macでexportすると
#       Claude Codeの経路が変わるため、このファイルには書かない(win側で必要時に追記)

# --- 検索API ---
# export BRAVE_API_KEY=xxx
# export CONTEXT7_API_KEY=xxx

# --- その他(環境固有の自由記述) ---
