    },
    {
        "$comment": "ターミナル起動しっぱでアプリ終了を回避するためのショトカ",
        "key": "cmd+q",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.terminal.killAll", // 全ターミナルのタスク kill
                "workbench.action.quit" // quit vscode
            ]
        }
    },
    {
        "$comment": "winの場合、terminalでの貼り付け有効化",
        "key": "ctrl+v",
        "when": "isWindows && terminalFocus",
        "command": "runCommands",
        "args": {
            "commands": ["editor.action.clipboardPasteAction"]
        }
    },
    {
        "command": "runCommands",
        "key": "ctrl+r",
        "when": "inQuickOpen",
        "args": {
            "commands": ["editor.action.clipboardPasteAction"]
        }
    },
    {
        "key": "ctrl+v",
        "when": "isMac && inputFocus && inQuickOpen",
        "command": "runCommands",
        "args": {
            "commands": ["editor.action.clipboardPasteAction"]
        }
    },
    // ===========================================================
    // ファイルエクスプローラー関連のカスタムキーバインド
    // 必要なCLI: fzf, ripgrep(rg), bat
    // ===========================================================
    {
        "command": "runCommands",
        "key": "ctrl+i",
        "when": "neovim.mode!=insert",
        "args": {
            "commands": ["workbench.action.quickOpen"]
        }
    },
    //   {
    //   "command": "runCommands",
    //   "key": "ctrl+i",
    //   "when": "neovim.mode!=insert && !terminalFocus",
