    //               }
    //           }
    //       ]
    //   }
    //   },
    {
        "command": "runCommands",
        "key": "ctrl+g",
        "when": "neovim.mode != insert && !terminalFocus",
        "args": {
            "commands": ["periscope.resumeSearch"]
        }
    },
    // {
    //     "command": "runCommands",
    //     "key": "ctrl+g",
    //     "when": "neovim.mode != insert && !terminalFocus",
    //     "args": {
    //         "commands": [
    //             "workbench.action.createTerminalEditor",
    //             {
    //                 "command": "workbench.action.terminal.sendSequence",
    //                 "args": {
    //                     "text": "rg --line-number --color=always '' | fzf --ansi --delimiter ':' --bind 'enter:become(code -g {1}:{2})' || exit 0\n"
    //                 }
    //             }
    //         ]
    //     }
    // },
    {
        "$": "explorer open",
        "command": "runCommands",
        "key": "ctrl+o",
        "when": "neovim.mode != insert && !explorerViewletVisible && !terminalFocus",
        "args": {
            "commands": [
                //
                "workbench.explorer.fileView.focus"
            ]
        }
    },
    {
        "$": "各サイドバー & 拡張機能パネルなどが開いた時向け",
        "command": "runCommands",
        "key": "ctrl+o",
        "when": "!terminalFocus && (neovim.mode != insert) && (explorerViewletVisible || foldersViewVisible || sideBarVisible)",
        "args": {
            "commands": [
                "workbench.action.closePanel",
                "workbench.action.closeSidebar",
                "workbench.action.closeAuxiliaryBar",
                "workbench.action.activityBarLocation.hide"
            ]
        }
    },
    {
        "$comment": "ツリー操作かつフィルタ結果である場合、フィルタを閉じる",
        "command": "runCommands",
        "key": "Enter",
        "when": "listFocus && treeFindOpen && explorerResourceIsFolder",
        "args": {
            "commands": ["list.closeFind", "list.expand"]
        }
    },
    {
        "$comment": "ファイルフィルタリング実行&j,kキーでの移動を有効化",
        "command": "runCommands",
        "key": "Enter",
        "when": "inputFocus && explorerViewletFocus",
        "args": {
            "commands": ["list.toggleFilterOnType", "list.expandSelectionDown"]
        }
    },
    {
        "$comment": "ツリー操作でファイルにフォーカスがある場合、ファイルを開きつつツリーを閉じる",
        "command": "runCommands",
        "key": "v",
        "when": "explorerViewletFocus && (explorerViewletVisible || foldersViewVisible) && !explorerResourceIsFolder && !inputFocus",
        "args": {
            "commands": [
                "explorer.openToSide",
                "workbench.action.toggleSidebarVisibility"
            ]
        }
    },
    // {
    //     "$comment": "ツリー操作でファイルにフォーカスがある場合、ファイルを開きつつツリーを閉じる(Enterキー版)",
    //     "key": "Enter",
    //     "command": "runCommands",
    //     "when": "explorerViewletFocus && (explorerViewletVisible || foldersViewVisible) && !explorerResourceIsFolder && !inputFocus",
    //     "args": {
    //         "commands": [
    //             "list.closeFind",
    //             "list.select",
    //             "workbench.action.closePanel",
    //             "workbench.action.closeSidebar",
    //             "workbench.action.closeAuxiliaryBar",
    //             "workbench.action.activityBarLocation.hide"
    //         ]
    //     }
    // },
    {
        "$comment": "ファイルツリーのフォルダを開閉",
        "key": "Enter",
        "when": "explorerViewletFocus && explorerViewletVisible && explorerResourceIsFolder && !inputFocus && !treeFindOpen",
        "command": "list.toggleExpand"
    },
    {
        "key": "m r",
        "command": "renameFile",
        "when": "(explorerViewletVisible && filesExplorerFocus && !inputFocus) || (foldersViewVisible && !inputFocus)"
    },
    {
        "key": "m c",
        "command": "filesExplorer.copy",
        "when": "(explorerViewletVisible && filesExplorerFocus && !inputFocus) || (foldersViewVisible && !inputFocus)"
    },
    {
        "key": "m p",
        "command": "filesExplorer.paste",
        "when": "(explorerViewletVisible && filesExplorerFocus && !inputFocus) || (foldersViewVisible && !inputFocus)"
    },
    {
        "command": "runCommands",
        "key": "m a",
        "when": "(explorerViewletVisible && filesExplorerFocus && !inputFocus) || (foldersViewVisible && !inputFocus)",
        "args": {
            "commands": ["explorer.newFile"]
        }
    },
    {
        "key": "m d",
        "command": "deleteFile",
        "when": "(explorerViewletVisible && filesExplorerFocus && !inputFocus) || (foldersViewVisible && !inputFocus)"
    },
    {
        "key": "m f",
        "command": "explorer.newFolder",
        "when": "(explorerViewletVisible && filesExplorerFocus && !inputFocus) || (foldersViewVisible && !inputFocus)"
    },
    {
        "$comment": "ソース管理を表示",
        "key": "ctrl+s",
        "command": "workbench.view.scm",
        "when": "!view.workbench.scm.visible"
    },
    {
        "$comment": "ソース管理を非表示",
        "key": "ctrl+s",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "view.workbench.scm.visible"
    },
    {
        "$comment": "lazygit(Open)",
        "key": "ctrl+t g",
        "command": "runCommands",
        "args": {
            "commands": [
                "coderm.workbench.modalEditor.open",
                "lazygit-vscode.toggle"
            ]
        }
    },
    {
        "$comment": "Git sync",
        "key": "ctrl+t n",
        "when": "neovim.mode == normal || lazygitFocus || terminalFocus",
        "command": "runCommands",
        "args": {
            "commands": ["git.sync"]
        }
    },
    // ===========================================================
    // エディタカスタムキーバインド(e.g. Neovim, jumpy2)
    // ===========================================================
    {
        "key": "ctrl+v",
        "when": "inputFocus && neovim.mode == 'insert'",
        "command": "runCommands",
        "args": {
            "commands": ["editor.action.clipboardPasteAction"]
        }
    },
    {
        "key": "ctrl+n",
        "command": "selectNextCodeAction",
        "when": "codeActionMenuVisible && !terminalFocus"
    },
    {
        "key": "ctrl+p",
        "command": "selectPrevCodeAction",
        "when": "codeActionMenuVisible && !terminalFocus"
    },
    {
        "$comment": "Open recent project",
        "key": "ctrl+t o",
        "command": "runCommands",
        "args": {
            "commands": ["workbench.action.openRecent"]
        }
    },
    {
        "key": "shift+;",
        "command": "vscode-neovim.send",
        "when": "neovim.mode != 'insert' && !view.workbench.scm.visible && !explorerViewletVisible && !view.workbench.view.search.visible && !inputBoxFocus && !inChatInput && !inQuickOpen && !terminalFocus && !jumpy2.jump-mode",
        "args": ":"
    },
    {
        "key": "f",
        "command": "jumpy2.toggle",
        "when": "neovim.mode =~ /^normal$|^visual$/ && !jumpy2.jump-mode && editorTextFocus"
    },
    {
        "key": "space h",
        "command": "editor.action.showHover",
        "when": "neovim.mode != insert && editorTextFocus"
    },
    {
        "$comment": "ビジュアルモードの場合、ブロックコメントアウト",
        "key": "g c",
        "command": "runCommands",
        "when": "neovim.mode == visual && editorTextFocus",
        "args": {
            "commands": [
                "editor.action.commentLine",
                "vscode-neovim.escape",
                "vscode-neovim.escape"
            ]
        }
    },
    {
        "$comment": "ノーマルモードの場合、行コメントアウト",
        "key": "g c c",
        "command": "editor.action.commentLine",
        "when": "neovim.mode == normal && editorTextFocus && !jumpy2.jump-mode"
    },
    {
        "command": "vscode-neovim.send",
        "key": "g g",
        "when": "(editorTextFocus && neovim.init && neovim.mode != insert || neovim.recording) && !jumpy2.jump-mode",
        "args": "gg"
    },
    {
        "key": "ctrl+.",
        "command": "editor.action.quickFix",
        "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly"
    },
    {
        "key": "space d",
        "command": "editor.action.goToDeclaration",
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "space b",
        "command": "workbench.action.navigateBack",
        "when": "neovim.mode == normal && editorTextFocus"
    },
    {
        "key": "ctrl+[",
        "command": "vscode-neovim.escape",
        "when": "neovim.mode == insert && editorTextFocus"
    },
    {
        "key": "ctrl+n",
        "when": "neovim.mode == normal && !codeActionMenuVisible && !inQuickOpen && !terminalFocus && focusedView != 'workbench.panel.chat.view.copilot'",
        "command": "workbench.action.nextEditorInGroup"
    },
    {
        "key": "ctrl+p",
        "command": "workbench.action.previousEditorInGroup",
        "when": "neovim.mode == normal && !codeActionMenuVisible && !inQuickOpen && !terminalFocus && focusedView != 'workbench.panel.chat.view.copilot'"
    },
    {
        "command": "vscode-neovim.send",
        "key": "ctrl+d",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert || neovim.recording",
        "args": "<C-D>"
    },
    {
        "command": "vscode-neovim.send",
        "key": "ctrl+u",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert || neovim.recording",
        "args": "<C-U>"
    },

    // ===========================================================
    // エディタウィンドウ操作関連カスタムキーバインド
    // ===========================================================
    {
        "key": "ctrl+w k",
        "when": "editorTextFocus && neovim.init && neovim.mode == normal",
        "command": "vscode-neovim.send",
        "args": "<C-W>k"
    },
    {
        "command": "vscode-neovim.send",
        "key": "ctrl+w j",
        "when": "editorTextFocus && neovim.init && neovim.mode == normal",
        "args": "<C-W>j"
    },
    {
        "command": "vscode-neovim.send",
        "key": "ctrl+w h",
        "when": "editorTextFocus && neovim.init && neovim.mode == normal",
        "args": "<C-W>h"
    },
    {
        "command": "vscode-neovim.send",
        "key": "ctrl+w l",
        "when": "editorTextFocus && neovim.init && neovim.mode == normal",
        "args": "<C-W>l"
    },
    {
        "command": "vscode-neovim.send",
        "key": "ctrl+w c",
        "when": "editorTextFocus && neovim.init && neovim.mode == normal",
        "args": "<C-W>c"
    },
    {
        "$": "エディタpane作成(vertical)",
        "key": "ctrl+t shift+5",
        "when": "!terminalFocus",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.unlockEditorGroup",
                "workbench.action.splitEditor",
                "workbench.action.unlockEditorGroup"
            ]
        }
    },
    {
        "$": "エディタpane作成(horizontal)",
        "key": "ctrl+t shift+'",
        "when": "!terminalFocus",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.unlockEditorGroup",
                "workbench.action.splitEditorDown",
                "workbench.action.unlockEditorGroup"
            ]
        }
    },
    {
        "$": "エディタpane-kill",
        "command": "runCommands",
        "key": "ctrl+t shift+7",
        "when": "textInputFocus && !terminalFocus && neovim.mode == normal",
        "args": {
            "commands": [
                "workbench.action.unlockEditorGroup",
                "workbench.action.closeEditorsInGroup"
            ]
        }
    },

    {
        "key": "ctrl+t k",
        "command": "workbench.action.navigateUp"
    },
    {
        "key": "ctrl+t j",
        "command": "workbench.action.navigateDown"
    },
    {
        "key": "ctrl+t h",
        "command": "workbench.action.navigateLeft"
    },
    {
        "key": "ctrl+t l",
        "command": "workbench.action.navigateRight"
    },
    {
        "key": "ctrl+t ctrl+l",
        "command": "coderm.workbench.editor.resizePaneRight"
    },
    {
        "key": "ctrl+t ctrl+h",
        "command": "coderm.workbench.editor.resizePaneLeft"
    },
    {
        "key": "ctrl+t ctrl+j",
        "command": "coderm.workbench.editor.resizePaneDown"
    },
    {
        "key": "ctrl+t ctrl+k",
        "command": "coderm.workbench.editor.resizePaneUp"
    },

    {
        "command": "vscode-neovim.send",
        "key": "ctrl+w v",
        "when": "editorTextFocus && neovim.init && neovim.mode == normal",
        "args": "<C-W>v"
    },
    {
        "command": "vscode-neovim.send",
        "key": "ctrl+w s",
        "when": "editorTextFocus && neovim.init && neovim.mode == normal",
        "args": "<C-W>s"
    },

    {
        "$": "エディタpane-kill",
        "command": "runCommands",
        "key": "ctrl+t shift+7",
        "when": "textInputFocus && !terminalFocus && neovim.mode == normal",
        "args": {
            "commands": ["workbench.action.closeEditorsInGroup"]
        }
    },
    // ===========================================================
    // ターミナルカスタムキーバインド
    // ===========================================================
    {
        "$": "ターミナルウィンドウ作成(horizontal)",
        "command": "runCommands",
        "key": "ctrl+t shift+'",
        "when": "terminalFocus",
        "args": {
            "commands": [
                "workbench.action.lockEditorGroup",
                "workbench.action.splitEditorDown",
                "workbench.action.lockEditorGroup"
            ]
        }
    },
    {
        "$comment": "ターミナルウィンドウ作成(vertical)",
        "command": "runCommands",
        "key": "ctrl+t shift+5",
        "when": "terminalFocus",
        "args": {
            "commands": [
                "workbench.action.lockEditorGroup",
                "workbench.action.splitEditorRight",
                "workbench.action.lockEditorGroup"
            ]
        }
    },
    {
        "$comment": "ターミナルkill",
        "command": "runCommands",
        "key": "ctrl+t shift+7",
        "when": "!textInputFocus",
        "args": {
            "commands": ["workbench.action.terminal.killEditor"]
        }
    },
    {
        "$comment": "ターミナルサジェスト次へ",
        "key": "ctrl+n",
        "command": "workbench.action.terminal.selectNextSuggestion",
        "when": "terminalFocus && terminalSuggestWidgetVisible"
    },
    {
        "$comment": "ターミナルサジェスト前へ",
        "key": "ctrl+p",
        "command": "workbench.action.terminal.selectPrevSuggestion",
        "when": "terminalFocus && terminalSuggestWidgetVisible"
    },
    {
        "$comment": "Terminal Page UP",
        "key": "ctrl+b",
        "when": "terminalFocus",
        "commands": ["workbench.action.terminal.scrollUpPage"]
    },
    {
        "key": "ctrl+t 0",
        "when": "neovim.mode == 'normal'",
        "command": "runCommands",
        "args": {
            "commands": ["workbench.explorer.fileView.focus"]
        }
    },
    {
        "key": "ctrl+t 1",
        "when": "neovim.mode == 'normal'",
        "command": "runCommands",
        "args": {
            "commands": ["workbench.action.focusFirstEditorGroup"]
        }
    },
    {
        "key": "ctrl+t 2",
        "when": "neovim.mode == 'normal'",
        "command": "runCommands",
        "args": {
            "commands": ["workbench.action.focusSecondEditorGroup"]
        }
    },
    {
        "key": "ctrl+t 3",
        "when": "neovim.mode == 'normal'",
        "command": "runCommands",
        "args": {
            "commands": ["workbench.action.focusThirdEditorGroup"]
        }
    },
    {
        "key": "ctrl+t 4",
        "when": "neovim.mode == 'normal'",
        "command": "runCommands",
        "args": {
            "commands": ["workbench.action.focusFourthEditorGroup"]
        }
    },
    {
        "key": "ctrl+t 5",
        "when": "neovim.mode == 'normal'",
        "command": "runCommands",
        "args": {
            "commands": ["workbench.action.focusFifthEditorGroup"]
        }
    },
    {
        "key": "ctrl+t 6",
        "when": "neovim.mode == 'normal'",
        "command": "runCommands",
        "args": {
            "commands": ["workbench.action.focusSixthEditorGroup"]
        }
    },
    {
        "key": "ctrl+t 7",
        "when": "neovim.mode == 'normal'",
        "command": "runCommands",
        "args": {
            "commands": ["workbench.action.focusSeventhEditorGroup"]
        }
    },
    {
        "key": "ctrl+t 8",
        "when": "inputFocus &&InputFocus && !terminalSuggestWidgetVisible",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0014[" }
    },
    // ===========================================================
    // ターミナルカスタムキーバインド(tmux/wtmux)
    // ===========================================================
    {
        "$comment": "copy mode - ターミナルにCtrl+T [をパススルー",
        "key": "ctrl+t [",
        "when": "terminalFocus && !textInputFocus && !terminalSuggestWidgetVisible",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0014[" }
    },
